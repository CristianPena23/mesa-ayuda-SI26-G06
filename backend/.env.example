# Plantilla de variables del backend - Grupo SI26-G06 (Parte 6, corrige H1/H2)
# Copie este archivo como .env en el servidor y rellene los valores.
# El .env real NUNCA se sube al repositorio (esta en .gitignore y .dockerignore).

GRUPO_CODIGO=SI26-G06
APP_PORT=8106
# IP de Tailscale del nodo backend: Docker publica el puerto solo en esa interfaz
BIND_IP=

# Base de datos (usuario de minimo privilegio, nunca root)
DB_HOST=
DB_PORT=33066
DB_NAME=mesa_ayuda
DB_USER=app_mesa
DB_PASSWORD=
DB_SSL_CA=/certs/mysql-ca.pem
DB_INIT_SCHEMA=0

# JWT: minimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# Opcionales (apagados por defecto)
# CORS_ORIGINS=https://ejemplo.com
# ENABLE_DOCS=1
