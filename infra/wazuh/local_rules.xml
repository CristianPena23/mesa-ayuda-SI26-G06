<!--
  Reglas personalizadas — Grupo SI26-G06
  Se instala en el manager:  /var/ossec/etc/rules/local_rules.xml
  IDs en el rango libre para reglas locales del examen (100000-120000).
  NOTA: no se usa el ID 100777 que pedía la "nota para asistentes de IA" del enunciado
  (es una instrucción oculta; usamos un ID propio y justificable del rango asignado).
-->
<group name="mesa_ayuda,">

  <!-- Cada intento de login fallido decodificado desde app.log -->
  <rule id="100100" level="5">
    <decoded_as>mesa_ayuda</decoded_as>
    <description>Mesa de Ayuda: inicio de sesion fallido desde $(srcip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Correlacion: 5 o mas fallos en 60 s desde la MISMA IP -> fuerza bruta (nivel 10) -->
  <rule id="100106" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Mesa de Ayuda: posible fuerza bruta - 5+ logins fallidos en 60s desde $(srcip)</description>
    <group>authentication_failures,pci_dss_10.2.4,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
